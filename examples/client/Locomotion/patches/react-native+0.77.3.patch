diff --git a/node_modules/react-native/sdks/hermes-engine/hermes-utils.rb b/node_modules/react-native/sdks/hermes-engine/hermes-utils.rb
index 5356dc1..4db6301 100644
--- a/node_modules/react-native/sdks/hermes-engine/hermes-utils.rb
+++ b/node_modules/react-native/sdks/hermes-engine/hermes-utils.rb
@@ -247,7 +247,17 @@ end
 def hermes_artifact_exists(tarball_url)
     # -L is used to follow redirects, useful for the nightlies
     # I also needed to wrap the url in quotes to avoid escaping & and ?.
-    return (`curl -o /dev/null --silent -Iw '%{http_code}' -L "#{tarball_url}"` == "200")
+    # Retry up to 3 times with exponential backoff to tolerate transient
+    # Maven Central / Sonatype hiccups that otherwise force a from-source build.
+    attempts = 0
+    max_attempts = 3
+    while attempts < max_attempts
+        status = `curl -o /dev/null --silent -Iw '%{http_code}' -L "#{tarball_url}"`.strip
+        return true if status == "200"
+        attempts += 1
+        sleep(2 ** attempts) if attempts < max_attempts
+    end
+    return false
 end
 
