+    return when (val value = backingList[index]) {
+      null -> ReadableType.Null
+      is Boolean -> ReadableType.Boolean
+      is Double,
+      is Float,
+      is Int,
+      is Long -> ReadableType.Number
+      is String -> ReadableType.String
