+    backingList.add(value)
+  }
+
+  override fun pushArray(array: ReadableArray?) {
+    backingList.add(array)
+  }
+
+  override fun pushMap(map: ReadableMap?) {
+    backingList.add(map)
+  }
+
+  override fun pushNull() {
+    backingList.add(null)
+  }
