+  reporter->reportMeasure("measure", 0, 50);
+  reporter->reportEvent("event1", 0, 100, 0, 0, 0);
+  reporter->reportEvent("event2", 0, 40, 0, 0, 0);
+  reporter->reportMark("mark1", 100);
+  reporter->reportEvent("event3", 0, 60, 0, 0, 0);
