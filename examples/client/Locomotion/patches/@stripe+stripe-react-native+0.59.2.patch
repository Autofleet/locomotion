+<manifest xmlns:android="http://schemas.android.com/apk/res/android"
+    package="com.reactnativestripesdk" >
+
+    <uses-sdk android:minSdkVersion="24" />
+
+    <application>
+        <activity
+            android:name="com.reactnativestripesdk.CustomPaymentMethodActivity"
+            android:excludeFromRecents="true"
+            android:exported="false"
+            android:launchMode="singleTop"
+            android:noHistory="true"
+            android:theme="@style/Theme.StripeReactNative.Transparent" />
+
+        <!-- Interceptor for stripe-connect:// deep links -->
+        <activity
+            android:name="com.reactnativestripesdk.StripeConnectDeepLinkInterceptorActivity"
+            android:excludeFromRecents="true"
+            android:exported="true"
+            android:launchMode="singleTask"
+            android:noHistory="true"
+            android:theme="@android:style/Theme.Translucent.NoTitleBar" >
+            <intent-filter>
+                <action android:name="android.intent.action.VIEW" />
